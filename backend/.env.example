# ─────────────────────────────────────────────────────────────
# Strapi CMS environment — copy to .env
# ─────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# Secrets — generate with: openssl rand -base64 32 (one per key)
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
JWT_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=news_portal
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Or use a single connection string (takes precedence when set):
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/news_portal

# Cloudinary media storage
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# GraphQL
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=true

# On-demand ISR — points at the Next.js revalidate route
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-a-long-random-string
