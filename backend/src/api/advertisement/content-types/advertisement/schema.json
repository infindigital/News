{
  "kind": "collectionType",
  "collectionName": "advertisements",
  "info": {
    "singularName": "advertisement",
    "pluralName": "advertisements",
    "displayName": "Advertisement",
    "description": "Ad placements and creatives"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "placement": {
      "type": "enumeration",
      "enum": ["header", "sidebar", "in_article", "footer", "homepage_leaderboard"],
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "targetUrl": {
      "type": "string"
    },
    "html": {
      "type": "text"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "startDate": {
      "type": "datetime"
    },
    "endDate": {
      "type": "datetime"
    }
  }
}
