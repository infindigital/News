{
  "kind": "collectionType",
  "collectionName": "live_blogs",
  "info": {
    "singularName": "live-blog",
    "pluralName": "live-blogs",
    "displayName": "Live Blog",
    "description": "Live blog coverage with timestamped entries"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "entries": {
      "type": "component",
      "repeatable": true,
      "component": "live.entry"
    }
  }
}
