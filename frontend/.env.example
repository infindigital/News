# ─────────────────────────────────────────────────────────────
# Frontend environment (Next.js) — copy to .env.local
# ─────────────────────────────────────────────────────────────

# Public site URL (used for canonical URLs, sitemaps, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Meridian News"

# Strapi CMS endpoints
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337/api
NEXT_PUBLIC_STRAPI_GRAPHQL_URL=http://localhost:1337/graphql

# Server-only Strapi token for privileged/ISR fetches (never exposed to client)
STRAPI_API_TOKEN=

# Revalidation secret for on-demand ISR webhooks from Strapi
REVALIDATE_SECRET=change-me-to-a-long-random-string

# When true, the app renders bundled mock data if Strapi is unreachable.
# Great for local UI development and CI. Set to false in production.
NEXT_PUBLIC_USE_MOCK_FALLBACK=true

# Analytics / third-party (optional)
NEXT_PUBLIC_GA_ID=
